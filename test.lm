const GREETING: str = "Hello, world!"

void main() {
    let x = 5
    let y = 10
    
    println("{GREETING}")
    println("The sum of {x} and {y} is {add(x, y)}")
    
    var i: int = 0
    while i < 10 {
        println("{i}")
        i = i + 1
    }

    i = 900
    println("i is now {i}")
}

int add(a: int, b: int) {
    return a + b
}